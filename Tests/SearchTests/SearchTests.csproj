<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Exercises query parsing, pinyin matching and the filter state on their own. The linked files
    only use the base class library; Program.cs supplies the one logger they call.

    Run from the repository root: dotnet run -\-project Tests/SearchTests
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Ryuka.Sulfur.Rummage.Tests</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Search\SearchQuery.cs" Link="SearchQuery.cs" />
    <Compile Include="..\..\src\Search\ItemCategory.cs" Link="ItemCategory.cs" />
    <Compile Include="..\..\src\Search\PinyinName.cs" Link="PinyinName.cs" />
    <Compile Include="..\..\src\Search\PinyinTable.cs" Link="PinyinTable.cs" />
    <Compile Include="..\..\src\Filter\InventoryFilter.cs" Link="InventoryFilter.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\src\Search\PinyinTable.bin">
      <LogicalName>Ryuka.Sulfur.Rummage.Search.PinyinTable.bin</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
